{
  "manifest_version": 3,
  "name": "SecondThought",
  "version": "0.2.0",
  "description": "Rewrite a heated workplace message professionally, keeping its facts, urgency, and asks.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SecondThought",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "triggers.js",
        "diff.js",
        "settings.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ]
}
